# Copy to .env and fill in. NEVER commit .env (it's in .gitignore).
AWS_REGION=us-east-2
S3_BUCKET=replace-with-cloudformation-output
DYNAMODB_TABLE=lpr-records
VEHICLES_TABLE=lpr-vehicles
# KMS key ARN from the CloudFormation output (leave empty if UseCustomerManagedKey=false)
KMS_KEY_ID=
# One key per client. Generate with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEYS=replace-with-generated-camera-key,replace-with-generated-frontend-key
MIN_OCR_CONFIDENCE=60
RETENTION_DAYS=30
# Windows only:
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# tesseract (free, runs on your server) or rekognition (better on real photos, ~$0.001/image;
# add rekognition:DetectText to the backend IAM policy)
OCR_ENGINE=tesseract
# auto = find the plate in the frame, fall back to treating the image as a crop (default)
# full = whole camera frames only (ESP32-P4-EYE sends 1920x1080); plate = pre-cropped plates only
INPUT_MODE=auto
# Fixed camera: where plates can appear, x0,y0,x1,y1 as fractions of the frame (empty = whole frame)
PLATE_ROI=
# Optional formats for position-based O/0, I/1, S/5 fixes. L=letter D=digit *=either. Michigan: LLLDDDD
PLATE_FORMATS=
# turn 9OO1 into 9001 (O/I between digits -> 0/1)
DIGIT_CONTEXT_FIX=true
