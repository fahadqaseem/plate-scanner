CONFIG_IDF_TARGET="esp32p4"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_CACHE_L2_CACHE_256KB=y
CONFIG_CACHE_L2_CACHE_LINE_128B=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_FREERTOS_HZ=1000
CONFIG_IDF_EXPERIMENTAL_FEATURES=y
# Camera: same as Espressif's factory_demo
CONFIG_CAMERA_OV2710=y
CONFIG_ESP_VIDEO_ENABLE_ISP_PIPELINE_CONTROLLER=y
# Wi-Fi through the on-board ESP32-C6 over ESP-Hosted
CONFIG_ESP_WIFI_REMOTE_EAP_ENABLED=n
CONFIG_SLAVE_IDF_TARGET_ESP32C6=y
# Reset/enable line of the C6 on the P4-EYE is GPIO9 (BSP_C6_EN_PIN)
CONFIG_ESP_HOSTED_SDIO_GPIO_RESET_SLAVE=9
# Binary frames on the console: no CR/LF translation
CONFIG_NEWLIB_STDOUT_LINE_ENDING_LF=y
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESP32P4_REV_MIN_100=y
